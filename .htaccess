# =============================================================================
# Elique Events — Apache configuration
# -----------------------------------------------------------------------------
# Every block is wrapped in <IfModule>. If the server does not have a module,
# that block is skipped instead of throwing a 500 and taking the site down.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Canonical host and HTTPS
# -----------------------------------------------------------------------------
# The site answers on both elique-events.com and www.elique-events.com. To a
# search engine those are two different sites with identical content, which
# splits the ranking value between them. Everything in the HTML — canonical
# tags, sitemap, structured data — declares the version WITHOUT www, so that
# is what these rules enforce.
#
# To switch to www instead, swap the two RewriteRule blocks below for:
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# and update the URLs in index.html, sitemap.xml and the service pages to match.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Strip www and force https in a single redirect rather than two hops
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Force https for the bare domain. Both conditions must fail before
  # redirecting, so this still works behind a TLS-terminating proxy.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# 2. Directory behaviour
# -----------------------------------------------------------------------------
DirectoryIndex index.html

# Without this, a visitor to /assets/ gets a browsable file listing
Options -Indexes

ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# 3. MIME types
# -----------------------------------------------------------------------------
# Older Apache builds do not know AVIF or WebP. Every image on this site is
# AVIF with a WebP fallback, so getting this wrong means the browser refuses
# images it is perfectly capable of showing.
<IfModule mod_mime.c>
  AddType image/avif                   .avif
  AddType image/avif-sequence          .avifs
  AddType image/webp                   .webp
  AddType image/svg+xml                .svg
  AddType application/manifest+json    .webmanifest
  AddType video/mp4                    .mp4
  AddType font/woff2                   .woff2
  AddType text/cache-manifest          .appcache

  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .json .webmanifest .xml .svg
</IfModule>

# -----------------------------------------------------------------------------
# 4. Compression
# -----------------------------------------------------------------------------
# Only text compresses usefully. AVIF, WebP and MP4 are already compressed —
# running them through gzip costs CPU and makes them very slightly larger.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
  </IfModule>
</IfModule>

<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  </IfModule>
</IfModule>

# -----------------------------------------------------------------------------
# 5. Caching
# -----------------------------------------------------------------------------
# Filenames are not content-hashed here, so an aggressive cache would leave
# visitors on a stale stylesheet after an update. HTML is therefore always
# revalidated, CSS and JS get a day, and media — which is replaced far less
# often — gets a month.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
  ExpiresByType text/xml                  "access plus 0 seconds"

  ExpiresByType text/css                  "access plus 1 day"
  ExpiresByType application/javascript    "access plus 1 day"
  ExpiresByType text/javascript           "access plus 1 day"

  ExpiresByType image/avif                "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"
  ExpiresByType video/mp4                 "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML must always be checked, or an update will not reach returning visitors
  <FilesMatch "\.(html|xml|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(avif|webp|png|jpe?g|svg|ico|mp4|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # -----------------------------------------------------------------------------
  # 6. Security headers
  # -----------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Remove the header that advertises which server software is running
  Header unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# 7. Block access to files that should never be served
# -----------------------------------------------------------------------------
<FilesMatch "^\.(htaccess|htpasswd|gitignore|gitattributes|env)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(md|yml|yaml|log|bak|sql)$">
  Require all denied
</FilesMatch>
